<Window x:Class="Planer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Planer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" ></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Background="Gray">
            
        </StackPanel>
            <Ellipse x:Name="AvatarEllipse"  Stroke="#CCCCCC" StrokeThickness="2" Height="40" Width="40">
            <Ellipse.Fill>
                <ImageBrush ImageSource="C:\Users\Anastasia\Pictures\Screenshots/avatar.png" 
                                    Stretch="UniformToFill"/>
            </Ellipse.Fill> </Ellipse>
        <ScrollViewer Background="Gray" Grid.Column="0" Grid.Row="1" VerticalScrollBarVisibility="Auto" >

            <StackPanel >
                <Button Content="календарь" Margin="10" Height="40" Width="60"/>
                <Button Content="цели" Margin="10" Height="40" Width="60"/>

                <Button Content="задачи" Margin="10" Height="40" Width="60"/>
                <Button Content="персонаж" Margin="10" Height="40" Width="60"/>
                <Button Content="история" Margin="10" Height="40" Width="60"/>
            </StackPanel>
                
        </ScrollViewer>
        <TextBox Grid.Column="1" Grid.Row="0" FontSize="30" Margin="10"> Название окна</TextBox>
        <TextBox Grid.Column="1" Grid.Row="1" FontSize="20" Margin="10">вся информация страницы</TextBox>
    </Grid>
</Window>
